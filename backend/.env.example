# Copy to .env for local development. Never commit the real .env file.

DATABASE_URL=postgresql://rdip:rdip@localhost:5432/rdip
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=rdip
MINIO_SECRET_KEY=rdip-secret
MINIO_SECURE=False
MINIO_BUCKET=rdip
# minio | local (local = files on disk under LOCAL_STORAGE_DIR, no MinIO needed)
STORAGE_BACKEND=minio
LOCAL_STORAGE_DIR=./storage

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5183
